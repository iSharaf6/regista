# Regista runs fully offline with no configuration. Set these to use real models and Azure services.

# Model provider: offline | foundry | azure_openai | openai
REGISTA_LLM=offline

# Microsoft Foundry project (Entra ID auth via DefaultAzureCredential / managed identity)
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-4.1-mini

# Azure OpenAI (key or Entra ID)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_KEY=

# Any OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

# Event bus: memory | eventhubs
REGISTA_BUS=memory
EVENTHUB_NAMESPACE=<namespace>.servicebus.windows.net
EVENTHUB_NAME=match-events

# Observability (Azure Monitor / Application Insights)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Start playing the demo match on boot; loops after full time and resumes abandoned pauses
REGISTA_AUTOPLAY=0

# Producer token: required for playback control, chaos and the live feed API when set
REGISTA_ADMIN_TOKEN=
# Pundit questions per viewer per minute
REGISTA_ASK_PER_MINUTE=8

# Webhooks to Slack / Microsoft Teams / Discord
REGISTA_WEBHOOK_URL=
REGISTA_WEBHOOK_LANG=en
REGISTA_WEBHOOK_PERSONA=casual
REGISTA_WEBHOOK_KINDS=goal,red_card,press_shift,half_time,full_time
